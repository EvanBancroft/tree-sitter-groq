{
  "name": "tree-sitter-groq",
  "version": "0.1.0",
  "description": "A query language and execution engine made at Sanity, Inc, for filtering and projecting JSON documents.",
  "repository": "https://github.com/evanbancroft/tree-sitter-groq",
  "license": "MIT",
  "author": {
    "name": "Evan Bancroft",
    "email": "contact@evanbancroft.com",
    "url": "https://evanbancroft.com/"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "groq"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.2.1",
    "node-gyp-build": "^4.8.2",
    "tree-sitter-json": "^0.24.8"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "prettier": "^3.4.2",
    "tree-sitter-cli": "^0.24.6"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js",
    "format": "prettier --write grammar.js",
    "format-check": "prettier --check grammar.js"
  }
}
